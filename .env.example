# ==============================================================================
# DIGITAL LIFE NAVIGATOR - ENVIRONMENT CONFIGURATION (SAMPLE)
# ==============================================================================
# Copy this file to backend/.env to configure backend settings.
# NOTE: The system works 100% out of the box with ₹0 cost using MockProvider.
# AWS credentials are fully OPTIONAL and only needed for live Bedrock AI testing.
# ==============================================================================

# Backend Settings
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite Database
DATABASE_URL=sqlite:///./digital_life_navigator.db

# AI Provider Selection: 'mock' (default ₹0) or 'bedrock' (AWS Bedrock)
AI_PROVIDER=mock

# Amazon Bedrock Settings (Optional for AWS Builder Mini-Challenge)
# If left blank, Digital Life Navigator gracefully uses the intelligent MockProvider.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Frontend Settings (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
